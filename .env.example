# Supabase (shared by all API services)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RabbitMQ — use Docker service name in docker-compose, localhost for local dev
AMQP_URL=amqp://conntrack:conntrack123@rabbitmq:5672

# RabbitMQ credentials (used by docker-compose to init the broker)
RABBITMQ_USER=conntrack
RABBITMQ_PASS=conntrack123

# API Gateway service routing (docker-compose sets these automatically)
AUTH_SERVICE_URL=http://api-auth:5001
ADMIN_SERVICE_URL=http://api-admin:5002
OPERATIONS_SERVICE_URL=http://api-operations:5003
LOGISTICS_SERVICE_URL=http://api-logistics:5004
SUPPLIER_SERVICE_URL=http://api-supplier:5005
DRIVER_SERVICE_URL=http://api-driver:5006

# Vite web apps (build-time, must be set before npm run build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:5000
